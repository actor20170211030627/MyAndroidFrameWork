<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.ViewPagerAndInnerFragment">

    <TextView
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="这是第1个Fragment" />

    <ToggleButton
        android:id="@+id/toggle_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:checked="true"
        android:disabledAlpha="0.5"
        android:textOff="内层ViewPager左右滑动 = false"
        android:textOn="内层ViewPager左右滑动 = true"
        app:layout_constraintTop_toBottomOf="@id/tv_content" />

    <com.actor.myandroidframework.widget.viewpager.ScrollableViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/red_trans_CC99"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toggle_button">

        <com.actor.myandroidframework.widget.BaseTabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:tabBackground="@drawable/selector_tablayout_blue_white"
            app:tabContentStart="20dp"
            app:tabIndicatorHeight="1dp"
            app:tabItemLayout="@layout/item_table_layout"
            app:tabMode="scrollable"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/white"
            app:tabTextColor="@color/blue_467DEC"
            tools:background="@color/gray_E3E3E3">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的" />
        </com.actor.myandroidframework.widget.BaseTabLayout>
    </com.actor.myandroidframework.widget.viewpager.ScrollableViewPager>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/et_position_fragment_pager_adapter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:digits="@string/digits_phone"
        android:hint="pos to add/remove"
        android:imeOptions="actionNext"
        android:inputType="number"
        app:layout_constraintBottom_toBottomOf="@id/view_pager"
        app:layout_constraintEnd_toStartOf="@id/btn_add_fragment_page_adapter"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_add_fragment_page_adapter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="addPage"
        app:layout_constraintEnd_toStartOf="@id/btn_remove_fragment_page_adapter"
        app:layout_constraintTop_toTopOf="@id/et_position_fragment_pager_adapter" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_remove_fragment_page_adapter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="removePage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/et_position_fragment_pager_adapter" />
</androidx.constraintlayout.widget.ConstraintLayout>
