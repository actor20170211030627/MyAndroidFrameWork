<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shape_radius="22dp"
    app:shape_solidColor="#DFF8F2"
    tools:context=".dialog.WheelViewSingleVerticalTestDialog">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="20dp"
            android:text="在Dialog中测试"
            android:textColor="#ff333333"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv0"
            app:layout_constraintTop_toBottomOf="@id/tv0"
            tools:itemCount="3"
            tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_wheel_view_vertical" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_get_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="getItem内容"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recycler_view" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_items_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="items Content"
        app:layout_constraintTop_toBottomOf="@id/btn_get_item" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/et_current_pos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:digits="@string/digits_phone"
        android:hint="currentPos"
        android:imeOptions="actionDone"
        android:inputType="number"
        android:text="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_items_content" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sc_smooth_scroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="平滑滚动"
        app:layout_constraintBottom_toBottomOf="@id/et_current_pos"
        app:layout_constraintStart_toEndOf="@id/et_current_pos" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_set_current_pos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="setCurrentPosition"
        app:layout_constraintStart_toEndOf="@id/sc_smooth_scroll"
        app:layout_constraintTop_toTopOf="@id/et_current_pos" />

    <com.hjq.shape.view.ShapeTextView
        android:id="@+id/stv_sure"
        android:layout_width="match_parent"
        android:layout_height="47dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:text="确定"
        android:textColor="#ffffffff"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_current_pos"
        app:shape_radius="99dp"
        app:shape_solidColor="#1FC39B" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="18dp"
        app:layout_constraintTop_toBottomOf="@id/stv_sure" />
</com.hjq.shape.layout.ShapeConstraintLayout>