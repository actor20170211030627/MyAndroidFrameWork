<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".activity.QQWeChatActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/red_trans_CC99"
            android:padding="5dp"
            android:text="1.QQ登录/退出"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btn_login_qq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="登录"
            android:transitionName="btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv0" />

        <Button
            android:id="@+id/btn_login_qr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="二维码登录"
            app:layout_constraintEnd_toStartOf="@id/btn_login_account_password"
            app:layout_constraintStart_toEndOf="@id/btn_login_qq"
            app:layout_constraintTop_toTopOf="@id/btn_login_qq" />

        <Button
            android:id="@+id/btn_login_account_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="账号密码登录"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_login_qq" />

        <Button
            android:id="@+id/btn_login_server_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="Server-Side登录模式"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_login_qq" />

        <com.actor.myandroidframework.widget.LineView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@id/btn_login_server_side"
            app:lvGradientCenterColor="@color/green_0D6971"
            app:lvGradientEndColor="@color/blue_5ECCFD"
            app:lvGradientStartColor="@color/red" />

        <Button
            android:id="@+id/btn_get_user_info_qq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="获取用户信息(需要先登录成功)"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_login_server_side" />

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="退出"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_get_user_info_qq" />

        <TextView
            android:id="@+id/tv_result_qq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="result"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@id/btn_get_user_info_qq" />


        <TextView
            android:id="@+id/tv1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/red_trans_CC99"
            android:padding="5dp"
            android:text="2.QQ分享区"
            app:layout_constraintTop_toBottomOf="@id/tv_result_qq" />

        <Button
            android:id="@+id/btn_share_img_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="分享图文"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv1" />

        <Button
            android:id="@+id/btn_share_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="分享图片"
            app:layout_constraintEnd_toStartOf="@id/btn_share_img2_qzone"
            app:layout_constraintStart_toEndOf="@id/btn_share_img_text"
            app:layout_constraintTop_toTopOf="@id/btn_share_img_text" />

        <Button
            android:id="@+id/btn_share_img2_qzone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="分享图文到QQ空间"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_share_img_text" />

        <!--        <EditText-->
        <!--            android:id="@+id/et_target_qq"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:digits="@string/digits_phone"-->
        <!--            android:hint="请输入对方QQ号"-->
        <!--            android:imeOptions="actionDone"-->
        <!--            android:inputType="number"-->
        <!--            android:maxLength="11" />-->

        <com.actor.others.widget.ItemTextInputLayout
            android:id="@+id/itil_target_qq"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:itilDigits="@string/digits_phone"
            app:itilImeOptions="actionDone"
            app:itilInputType="number"
            app:itilItemName="对方QQ:"
            app:itilMaxLength="15"
            app:layout_constraintEnd_toStartOf="@id/btn_chat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_share_img_text" />

        <Button
            android:id="@+id/btn_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="聊天"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/itil_target_qq" />


        <TextView
            android:id="@+id/tv3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/red_trans_CC99"
            android:padding="5dp"
            android:text="微信区"
            app:layout_constraintTop_toBottomOf="@id/itil_target_qq" />

        <Button
            android:id="@+id/btn_login_wechat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="登录"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv3" />

        <Button
            android:id="@+id/btn_login_wechat_qrcode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="扫码登录"
            app:layout_constraintStart_toEndOf="@id/btn_login_wechat"
            app:layout_constraintTop_toTopOf="@id/btn_login_wechat" />

        <com.actor.myandroidframework.widget.LineView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@id/btn_login_wechat"
            app:lvGradientCenterColor="@color/green_0D6971"
            app:lvGradientEndColor="@color/blue_5ECCFD"
            app:lvGradientStartColor="@color/red" />

        <Button
            android:id="@+id/btn_subscribe_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="订阅消息"
            app:layout_constraintStart_toStartOf="@id/tv3"
            app:layout_constraintTop_toBottomOf="@id/btn_login_wechat" />

        <Button
            android:id="@+id/btn_subscribe_mini_program_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="订阅小程序消息"
            app:layout_constraintStart_toEndOf="@id/btn_subscribe_message"
            app:layout_constraintTop_toTopOf="@id/btn_subscribe_message" />

        <com.actor.myandroidframework.widget.LineView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@id/btn_subscribe_message"
            app:lvGradientCenterColor="@color/green_0D6971"
            app:lvGradientEndColor="@color/blue_5ECCFD"
            app:lvGradientStartColor="@color/red" />

        <Button
            android:id="@+id/btn_launch_mini_program"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="拉起小程序"
            app:layout_constraintStart_toStartOf="@id/tv3"
            app:layout_constraintTop_toBottomOf="@id/btn_subscribe_message" />

        <Button
            android:id="@+id/btn_open_customer_service_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="拉起客服微信"
            app:layout_constraintStart_toEndOf="@id/btn_launch_mini_program"
            app:layout_constraintTop_toTopOf="@id/btn_launch_mini_program" />

        <com.actor.myandroidframework.widget.LineView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@id/btn_launch_mini_program"
            app:lvGradientCenterColor="@color/green_0D6971"
            app:lvGradientEndColor="@color/blue_5ECCFD"
            app:lvGradientStartColor="@color/red" />

        <Button
            android:id="@+id/btn_share_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="分享文字"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_launch_mini_program" />

        <Button
            android:id="@+id/btn_share_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="分享图片"
            app:layout_constraintEnd_toStartOf="@id/btn_share_video_url"
            app:layout_constraintStart_toEndOf="@id/btn_share_text"
            app:layout_constraintTop_toTopOf="@id/btn_share_text" />

        <Button
            android:id="@+id/btn_share_video_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="分享网络视频Url"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_share_text" />

        <Button
            android:id="@+id/btn_share_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="分享链接url"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_share_text" />

        <Button
            android:id="@+id/btn_share_miniprogram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="分享小程序"
            app:layout_constraintEnd_toStartOf="@id/btn_share_music"
            app:layout_constraintStart_toEndOf="@id/btn_share_url"
            app:layout_constraintTop_toTopOf="@id/btn_share_url" />

        <Button
            android:id="@+id/btn_share_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="分享音乐"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_share_url" />

        <Button
            android:id="@+id/btn_share_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="分享文件"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_share_url" />

        <Button
            android:id="@+id/btn_share_file_by_intent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="通过Intent分享文件"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_share_file" />

        <com.actor.myandroidframework.widget.LineView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@id/btn_share_file"
            app:lvGradientCenterColor="@color/green_0D6971"
            app:lvGradientEndColor="@color/blue_5ECCFD"
            app:lvGradientStartColor="@color/red" />

        <Button
            android:id="@+id/btn_pay_wechat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="支付"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_share_file" />

        <Button
            android:id="@+id/btn_pay_offline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onViewClicked"
            android:text="打开离线支付"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_pay_wechat" />

        <TextView
            android:id="@+id/tv_result_wechat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="result"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@id/btn_pay_wechat" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
