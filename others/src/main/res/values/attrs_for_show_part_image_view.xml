<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="ShowPartImageView">
        <!--显示图片的哪部分-->
        <attr name="spivShowGravity" format="enum">
            <!-- Push object to the top of its container, not changing its size. -->
            <enum name="top" value="0x30" />
            <!-- Push object to the bottom of its container, not changing its size. -->
            <enum name="bottom" value="0x50" />
            <!-- Push object to the left of its container, not changing its size. -->
            <enum name="left" value="0x03" />
            <!-- Push object to the right of its container, not changing its size. -->
            <enum name="right" value="0x05" />
        </attr>

        <!--
        当图片太宽的时候, Gravity=right 时, 图片drawable是否和ImageView的'右侧'对齐
        当图片太高的时候, Gravity=bottom 时, 图片drawable是否和ImageView的'底部'对齐
     -->
        <attr name="spivIsAlignGravityWhenIv2WidthOrIv2Height" format="boolean" />
    </declare-styleable>
</resources>