<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--这是ItemSwitchLayout的属性-->
    <declare-styleable name="ItemSwitchLayout">

        <!--左边的红点是否显示-->
        <attr name="isclRedStarVisibility" format="enum">
            <enum name="visible" value="0" />
            <enum name="invisible" value="1" />
            <enum name="gone" value="2" />
        </attr>

        <!--左边的文字-->
        <attr name="isclItemName" format="string" />

        <!--marginTop距离顶部的间距, 默认1dp-->
        <attr name="isclMarginTop" format="dimension" />

        <!--是否选中✅-->
        <attr name="isclChecked" format="boolean" />

        <!--主container的最小高度, 默认49dp-->
        <attr name="isclContainerMinHeight" format="dimension" />

        <!--不使用默认布局, 自定义布局-->
        <attr name="isclCustomLayout" format="reference" />
    </declare-styleable>
</resources>