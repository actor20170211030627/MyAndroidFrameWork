<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".widget.ItemSwitchLayout">

    <Space
        android:id="@+id/space_margin_top_for_irgl"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <LinearLayout
        android:id="@+id/ll_content_for_irgl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="50dp"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <TextView
            android:id="@+id/tv_red_star_for_irgl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="* "
            android:textColor="#D90000"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tv_item_for_irgl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="90dp"
            android:textColor="#333333"
            android:textSize="17sp"
            tools:text="islItemName：" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--        <androidx.appcompat.widget.SwitchCompat-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:textOff="assets"-->
        <!--            android:textOn="resource"-->
        <!--            android:text="字体获取自:"-->
        <!--            android:checked="true"-->
        <!--            app:showText="true"-->
        <!--            app:switchPadding="5dp"-->
        <!--            android:layout_height="wrap_content"/>-->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_for_isl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>